+	/**
+	 * Ports on which private-network hosts may be fetched: 80, 443 and Config::ALLOW_PORTS.
+	 * @return array<int>
+	 */
+	static function private_ports(): array {
+		$ports = [80, 443];
+
+		foreach (explode(',', (string) Config::get(Config::ALLOW_PORTS)) as $p) {
+			$p = trim($p);
+
+			if (ctype_digit($p) && (int) $p > 0 && (int) $p < 65536)
+				$ports[] = (int) $p;
+		}
+
+		return array_values(array_unique($ports));
+	}
+
